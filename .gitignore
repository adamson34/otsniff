/target
**/*.rs.bk
Cargo.lock.bak

# Test fixtures (large PCAPs not committed)
tests/fixtures/*.pcap
tests/fixtures/*.pcapng
tests/fixtures/*.json
tests/fixtures/*.html

# Pending insta snapshots (must be reviewed, not committed)
*.snap.new
.snap-rejects/

# Reports / scratch
*.report.html
/report.html
/report.md
/findings.json
out/

# AI-flow artifacts — `*.map.json` is a deanonymization key for any
# scrubbed AI output. `*.audit.json` is the per-run chain-of-custody
# log. Neither should be committed.
*.map.json
*.audit.json
*.scrubbed.md

# OS / editor
.DS_Store
.idea/
.vscode/
media/*.pcap
