/target
**/*.rs.bk
Cargo.lock.bak

# Test fixtures (large PCAPs not committed — except the synthetic benchmark fixture)
# `**` is recursive so captures in subdirectories (e.g. captures1_v2/clean/*.pcap)
# are ignored too — a plain `*` only matches files directly under tests/fixtures/.
tests/fixtures/**/*.pcap
tests/fixtures/**/*.pcapng
tests/fixtures/**/*.json
tests/fixtures/**/*.html
!tests/fixtures/synthetic-1mb.pcap

# Pending insta snapshots (must be reviewed, not committed)
*.snap.new
.snap-rejects/

# cargo-mutants output (mutation-testing run artifacts, regenerated each run)
mutants.out/
mutants.out.old/

# Reports / scratch
*.report.html
/report.html
/report.md
/findings.json
out/

# AI-flow artifacts — `*.map.json` is a deanonymization key for any
# scrubbed AI output. `*.audit.json` is the per-run chain-of-custody
# log. Neither should be committed.
*.map.json
*.audit.json
*.scrubbed.md

# OS / editor
.DS_Store
.idea/
.vscode/
media/*.pcap

# vsdd-factory worktree — checked out from the factory-artifacts orphan
# branch, separate history from main/develop. Don't track from this side.
.factory/
.factory-project/
.worktrees/

# libFuzzer corpus and build artifacts
fuzz/target/
fuzz/corpus/
# Note: fuzz/artifacts/ is NOT ignored — those are regression seeds (AC-004)
