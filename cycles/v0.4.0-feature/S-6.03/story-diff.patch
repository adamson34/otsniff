+  </div>
+</div>
+
+{% if !findings_new.is_empty() %}
+<h2>New findings — NEW since baseline</h2>
+{% for f in findings_new %}
+<details open class="finding sev-{{ f.severity_class }}">
+  <summary>
+    <span class="badge sev-{{ f.severity_class }}">{{ f.severity_label }}</span>
+    <span class="badge badge-new">NEW since baseline</span>
+    <strong>{{ f.title }}</strong>
+  </summary>
+  <p class="muted" style="font-size:0.85rem;margin:0.25rem 0;">id: <code>{{ f.id }}</code></p>
+  <p style="margin:0.5rem 0;">{{ f.summary }}</p>
+  {% if !f.evidence.is_empty() %}
+  <details><summary>Evidence ({% if f.evidence_total > f.evidence_count %}showing {{ f.evidence_count }} of {{ f.evidence_total }}{% else %}{{ f.evidence_count }} sample(s){% endif %})</summary>
+  <pre class="evidence">{% for e in f.evidence %}{{ e }}
+{% endfor %}</pre>
+  </details>
+  {% endif %}
+  <p style="margin:0.5rem 0;"><strong>Recommendation:</strong> {{ f.recommendation }}</p>
+</details>
+{% endfor %}
+{% endif %}
+
+{% if !findings_recurring.is_empty() %}
+<h2>Recurring findings</h2>
+{% for f in findings_recurring %}
