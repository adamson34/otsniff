<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>otsniff report — tests/fixtures/synthetic.pcap</title>
<style>
  :root {
    --fg: #1a1a1a;
    --muted: #666;
    --bg: #fff;
    --card: #f7f7f8;
    --line: #e3e3e7;
    --crit: #b3261e;
    --high: #b9520b;
    --med: #8b6e00;
    --info: #4d6580;
    --ok: #2e7d32;
  }
  html { background: var(--bg); color: var(--fg); }
  body {
    font: 14px/1.45 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    max-width: 1100px;
    margin: 2rem auto;
    padding: 0 1.5rem;
  }
  h1 { font-size: 1.6rem; margin-bottom: 0.25rem; }
  h2 { font-size: 1.15rem; margin-top: 2rem; border-bottom: 1px solid var(--line); padding-bottom: 0.3rem; }
  h3 { font-size: 1rem; margin: 0.5rem 0 0.25rem 0; }
  .muted { color: var(--muted); }
  .meta { color: var(--muted); font-size: 0.9rem; margin-bottom: 1.5rem; }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 0.75rem; margin: 1rem 0 1.5rem 0; }
  .stat { background: var(--card); border: 1px solid var(--line); border-radius: 6px; padding: 0.75rem 1rem; }
  .stat .n { font-size: 1.4rem; font-weight: 600; }
  .stat .l { color: var(--muted); font-size: 0.85rem; }
  .finding {
    border: 1px solid var(--line);
    border-left-width: 4px;
    border-radius: 6px;
    padding: 0.9rem 1rem;
    margin: 0.75rem 0;
    background: var(--card);
  }
  .finding.sev-critical { border-left-color: var(--crit); }
  .finding.sev-high { border-left-color: var(--high); }
  .finding.sev-medium { border-left-color: var(--med); }
  .finding.sev-info { border-left-color: var(--info); }
  .badge {
    display: inline-block;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
    font-weight: 600;
    color: #fff;
    margin-right: 0.5rem;
    vertical-align: 1px;
  }
  .badge.sev-critical { background: var(--crit); }
  .badge.sev-high { background: var(--high); }
  .badge.sev-medium { background: var(--med); }
  .badge.sev-info { background: var(--info); }
  .ot-badge { display: inline-block; font-size: 0.7rem; padding: 0.1rem 0.45rem; border-radius: 3px; background: #1f3b5e; color: #fff; }
  details { margin-top: 0.5rem; }
  details summary { cursor: pointer; color: var(--muted); }
  pre.evidence {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 0.6rem 0.75rem;
    font: 12px/1.45 ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    white-space: pre-wrap;
    word-break: break-all;
    margin: 0.4rem 0 0 0;
  }
  table { border-collapse: collapse; width: 100%; font-size: 0.9rem; }
  th, td { text-align: left; padding: 0.4rem 0.6rem; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { background: var(--card); font-weight: 600; }
  td.num { text-align: right; font-variant-numeric: tabular-nums; }
  .no-findings { color: var(--ok); padding: 0.5rem 0; }
  footer { margin-top: 3rem; color: var(--muted); font-size: 0.8rem; border-top: 1px solid var(--line); padding-top: 0.75rem; }
  @media print {
    body { max-width: none; margin: 0; padding: 1rem; }
    .finding { break-inside: avoid; }
    details[open] summary { display: none; }
    details { margin: 0; }
  }
</style>
</head>
<body>

<h1>otsniff report</h1>
<div class="meta">
  Source: <code>tests/fixtures/synthetic.pcap</code><br>
